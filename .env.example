# Copy this file to .env and fill in your own values.
# Get an API key from https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for replies. claude-sonnet-5 is the default (best quality).
# Use claude-haiku-4-5-20251001 for a cheaper/faster option.
CLAUDE_MODEL=claude-sonnet-5

# What the assistant calls itself.
ASSISTANT_NAME=Jarvis

# Ask for confirmation before writing files or running shell commands.
# Keep this "true" unless you fully trust the assistant's tool calls.
CONFIRM_DANGEROUS_ACTIONS=true
