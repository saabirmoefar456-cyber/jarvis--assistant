# Copy this file to .env and adjust as needed.

# Which LLM powers the assistant:
#   ollama    - free, fully local/offline. Needs Ollama installed and a
#               model pulled first (see README's "Free local model" section).
#   anthropic - Claude via the Anthropic API. Paid per token, higher quality.
LLM_BACKEND=ollama

# --- Ollama settings (only used when LLM_BACKEND=ollama) ---
OLLAMA_HOST=http://localhost:11434
# Any tool-calling-capable model you've pulled with `ollama pull <name>`.
OLLAMA_MODEL=llama3.1

# --- Anthropic settings (only used when LLM_BACKEND=anthropic) ---
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# claude-sonnet-5 is the default (best quality). Use claude-haiku-4-5 for a
# cheaper/faster option.
CLAUDE_MODEL=claude-sonnet-5

# What the assistant calls itself.
ASSISTANT_NAME=Jarvis

# Ask for confirmation before writing files or running shell commands.
# Keep this "true" unless you fully trust the assistant's tool calls.
CONFIRM_DANGEROUS_ACTIONS=true
